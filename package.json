{
    "name": "gcal-to-ics",
    "version": "1.0.0",
    "description": "A Firefox extension that intercepts links that create new Google Calendar events and turns them into iCalendar files",
    "type": "module",
    "scripts": {
        "test": "vitest",
        "lint": "eslint",
        "check": "tsc --noEmit",
        "dev": "concurrently 'rollup -c --watch' 'web-ext run --devtools'",
        "bundle": "rollup -c",
        "build": "web-ext build",
        "web-ext-lint": "web-ext lint",
        "sign": "web-ext sign"
    },
    "packageManager": "pnpm@11.13.0",
    "devDependencies": {
        "@eslint/compat": "2.1.0",
        "@eslint/js": "10.0.1",
        "@rollup/plugin-commonjs": "29.0.3",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/firefox-webext-browser": "143.0.0",
        "@types/node": "24.13.3",
        "concurrently": "10.0.3",
        "eslint": "10.7.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "globals": "17.7.0",
        "husky": "9.1.7",
        "jiti": "2.7.0",
        "jsdom": "29.1.1",
        "lint-staged": "17.0.8",
        "prettier": "3.9.5",
        "rollup": "4.62.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.64.0",
        "vitest": "4.1.10",
        "web-ext": "10.5.0"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "ical-generator": "^11.0.0",
        "timezones-ical-library": "^2.2.1"
    }
}
