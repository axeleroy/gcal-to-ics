{
    "name": "gcal-to-ics",
    "version": "1.0.0",
    "description": "A Firefox extension that intercepts links that create new Google Calendar events and turns them into iCalendar files",
    "type": "module",
    "scripts": {
        "test": "vitest",
        "lint": "eslint",
        "dev": "concurrently 'rollup -c --watch' 'web-ext run --devtools'",
        "bundle": "rollup -c",
        "build": "web-ext build",
        "web-ext-lint": "web-ext lint",
        "sign": "web-ext sign"
    },
    "packageManager": "pnpm@10.33.0",
    "devDependencies": {
        "@eslint/compat": "^2.0.3",
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/firefox-webext-browser": "^143.0.0",
        "@types/node": "^24.12.0",
        "concurrently": "^9.2.1",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "jsdom": "^29.0.1",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.1",
        "rollup": "^4.60.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.0",
        "vitest": "^4.1.2",
        "web-ext": "^10.1.0"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "ical-generator": "^10.1.0",
        "timezones-ical-library": "^2.1.3"
    }
}
